@using Safety_Tech.DTOs.UserDTOs
@model LoginDto

 <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <!-- Bootstrap CSS -->
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

    <style>
      /*   .card{
           width: 528px;
        } */
    </style>
</head>
<body>

    <div class="container mt-5">
        <div class="row">
            <!-- Normal Login -->
            <div class="col-md-12 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Login</h5>
                        <form id="normalLoginForm" action="/Auth/Login" method="post" method="post">
                            <div class="form-group">
                                <label for="username">Username or Email</label>
                                <input id="txtUsername" asp-for="Username" type="text" class="form-control" name="username" required>
                            </div>
                            <div class="form-group">
                                <label for="password">Password</label>
                                <input id="txtPassword" type="password" asp-for="Password" class="form-control" name="password" required>
                            </div>
                            <button id="btnLogin" type="submit" class="btn btn-primary btn-block">Login</button>
                            <div id="loginError" class="text-danger mt-2" style="display: none;"></div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
