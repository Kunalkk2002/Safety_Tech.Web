@using Safety_Tech.DTOs.UserDTOs
@model LoginDto

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container min-vh-100 d-flex justify-content-center align-items-center">
    <div class="card shadow-sm login-card w-100" style="max-width: 440px;">
        <div class="card-body p-4">
            <h4 class="card-title mb-3 text-center">Sign in</h4>
            <p class="text-muted text-center mb-4">Access your Safety_Tech dashboard</p>
            <form id="normalLoginForm" action="/Auth/Login" method="post">
                <div class="form-group mb-3">
                    <label for="txtUsername" class="form-label">Username or Email</label>
                    <input id="txtUsername" asp-for="Username" type="text" class="form-control" name="username" placeholder="e.g. john@company.com" required>
                </div>
                <div class="form-group mb-3">
                    <label for="txtPassword" class="form-label">Password</label>
                    <input id="txtPassword" type="password" asp-for="Password" class="form-control" name="password" placeholder="••••••••" required>
                </div>
                <button id="btnLogin" type="submit" class="btn btn-primary w-100">Login</button>
                <div id="loginError" class="text-danger mt-2" style="display: none;"></div>
            </form>
        </div>
    </div>
</div>
