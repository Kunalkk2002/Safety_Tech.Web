@model Safety_Tech.Models.Models.HtmlControlsDemo
@{
    ViewData["Title"] = "HTML Controls Demo";
}

<h2>HTML Controls Demo</h2>
@if (ViewBag.Message != null)
{
    <div class="alert alert-success">@ViewBag.Message</div>
}
<form asp-action="HtmlControlsDemo" method="post" id="demoForm">
    <div class="form-group">
        <label asp-for="TextBox"></label>
        <input asp-for="TextBox" class="form-control" />
        <span asp-validation-for="TextBox" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Password"></label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Number"></label>
        <input asp-for="Number" class="form-control" />
        <span asp-validation-for="Number" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Date"></label>
        <input asp-for="Date" class="form-control" />
        <span asp-validation-for="Date" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Time"></label>
        <input asp-for="Time" class="form-control" />
        <span asp-validation-for="Time" class="text-danger"></span>
    </div>
    <div class="form-group form-check">
        <input asp-for="Checkbox" class="form-check-input" />
        <label asp-for="Checkbox" class="form-check-label"></label>
        <span asp-validation-for="Checkbox" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Radio Options</label><br />
        <input type="radio" asp-for="RadioOption" value="Option1" /> Option 1
        <input type="radio" asp-for="RadioOption" value="Option2" /> Option 2
        <span asp-validation-for="RadioOption" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Dropdown"></label>
        <select asp-for="Dropdown" class="form-control">
            <option value="">-- Select --</option>
            <option value="A">A</option>
            <option value="B">B</option>
            <option value="C">C</option>
        </select>
        <span asp-validation-for="Dropdown" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="TextArea"></label>
        <textarea asp-for="TextArea" class="form-control"></textarea>
        <span asp-validation-for="TextArea" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Url"></label>
        <input asp-for="Url" class="form-control" />
        <span asp-validation-for="Url" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Phone"></label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="form-group form-check">
        <input asp-for="AcceptTerms" class="form-check-input" />
        <label asp-for="AcceptTerms" class="form-check-label">Accept Terms</label>
        <span asp-validation-for="AcceptTerms" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            $("#demoForm").validate();
        });
    </script>
} 