@using Safety_Tech.Models.ViewModels
@model IncidentViewModel
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Kendo Grid Test</title>

    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,typography"></script>

    <!-- jQuery first -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Kendo UI -->
    <link href="https://kendo.cdn.telerik.com/2023.2.829/styles/kendo.default-v2.min.css" rel="stylesheet" />
    <script src="https://kendo.cdn.telerik.com/2023.2.829/js/kendo.all.min.js"></script>
</head>
<body class="bg-gray-900 text-white p-6">
    <h3 class="mb-4">Recent Incidents</h3>
    <div id="grid"></div>

    <script>
        jQuery(document).ready(function () {
            // Test static data first
            var incidentsData = [
                { cameraName: "Cam A", cameraId: "C001", trackId: "T001", missingLabels: "None", violationType: "Slip", timestamp: new Date() },
                { cameraName: "Cam B", cameraId: "C002", trackId: "T002", missingLabels: "Label1", violationType: "Trip", timestamp: new Date() }
            ];

            $("#grid").kendoGrid({
                dataSource: {
                    data: incidentsData,
                    schema: {
                        model: {
                            fields: {
                                cameraName: { type: "string" },
                                cameraId: { type: "string" },
                                trackId: { type: "string" },
                                missingLabels: { type: "string" },
                                violationType: { type: "string" },
                                timestamp: { type: "date" }
                            }
                        }
                    },
                    pageSize: 20
                },
                height: 400,
                sortable: true,
                pageable: true,
                filterable: { mode: "row" },
                columns: [
                    { field: "cameraName", title: "Camera Name" },
                    { field: "cameraId", title: "Camera Id" },
                    { field: "trackId", title: "Track Id" },
                    { field: "missingLabels", title: "Missing Labels" },
                    { field: "violationType", title: "Violation Type" },
                    { field: "timestamp", title: "Date", format: "{0:yyyy-MM-dd HH:mm}" }
                ]
            });
        });
    </script>
</body>
</html>
