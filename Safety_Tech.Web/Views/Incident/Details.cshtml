@using Safety_Tech.Models.ViewModels
@model IncidentViewModel;

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dark Themed Kendo UI Grid</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,typography"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap"
          rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
    <!-- Kendo UI CSS (match ASP.NET Core MVC wrapper version) -->
    <link rel="stylesheet" href="https://kendo.cdn.telerik.com/2023.1.117/styles/kendo.default-v2.min.css" />

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Kendo UI JS (match version) -->
    <script src="https://kendo.cdn.telerik.com/2023.1.117/js/kendo.all.min.js"></script>


    <!-- Kendo ASP.NET MVC wrappers helper (provides kendo.syncReady) -->
    <script src="https://kendo.cdn.telerik.com/2023.1.117/js/kendo.aspnetmvc.min.js"></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #131239;
            color: white;
            margin: 20px;
        }

        /* Disable browser-native input clear buttons */
        input::-ms-clear,
        input::-ms-reveal,
        input::-webkit-search-cancel-button {
            display: none;
            width: 0;
            height: 0;
        }

        /* Grid container */
        #grid {
            background-color: #222A51;
            border-radius: 0.75rem;
            padding: 10px;
        }

            /* Grid header */
            #grid .k-grid-header th {
                background-color: #131239 !important;
                color: white !important;
                border-color: #374151 !important;
            }

            /* Ensure header + filter row surfaces are dark */
            #grid .k-grid-header,
            #grid .k-filter-row,
            #grid .k-filter-row .k-table-td,
            #grid .k-table-th {
                background-color: #131239 !important;
                color: white !important;
                border-color: #374151 !important;
            }

                /* Filter row inputs */
                #grid .k-grid-header .k-textbox,
                #grid .k-grid-header .k-dropdown,
                #grid .k-grid-header .k-picker-wrap,
                #grid .k-grid-header .k-input-inner {
                    background-color: #374151 !important;
                    color: white !important;
                    border-color: #4B5563 !important;
                }

            /* Hide Kendo clear (cross) buttons inside filter inputs */
            #grid .k-input-button,
            #grid .k-clear-value {
                display: none !important;
            }

            /* Grid rows */
            #grid .k-grid-content tr {
                background-color: #222A51;
                color: white;
            }

                #grid .k-grid-content tr.k-alt {
                    background-color: #1F233F;
                }

            /* Dark background for empty content area */
            #grid .k-grid-content,
            #grid .k-grid-content-locked {
                background-color: #222A51 !important;
            }

            /* Body cell borders/text */
            #grid .k-table,
            #grid .k-table tbody,
            #grid .k-table tr,
            #grid .k-table-td {
                background-color: transparent !important;
                color: white !important;
                border-color: #2C3464 !important;
            }

            /* Pager */
            #grid .k-pager {
                background-color: #222A51 !important;
                color: white !important;
            }

                #grid .k-pager .k-link {
                    color: white !important;
                }

        /* Buttons inside grid */
        .k-button {
            border-radius: 0.75rem !important;
            font-size: 0.875rem;
            font-weight: 500;
        }

        .btn-approve {
            background-color: #16A34A;
            color: white;
        }

        .btn-reject {
            background-color: #DC2626;
            color: white;
        }

        .btn-view {
            background-color: #2563EB;
            color: white;
        }

        .btn-approve, .btn-reject, .btn-view {
            padding: 4px 12px;
            border: 0;
            display: inline-block;
        }

        a.k-button.btn-view {
            text-decoration: none;
        }

        .btn-approve:hover {
            background-color: #15803D;
        }

        .btn-reject:hover {
            background-color: #B91C1C;
        }

        .btn-view:hover {
            background-color: #1D4ED8;
        }

        /* Make sure the grid draws horizontal separators */
        #grid .k-table td,
        #grid .k-grid-content td {
            border-bottom: 1px solid #e5e7eb !important;
        }

        /* Optional: remove last row border */
        #grid .k-table tr:last-child td {
            border-bottom: none !important;
        }

        /* Transparent header */
        #grid .k-grid-header,
        #grid .k-grid-header th,
        #grid .k-table-th {
            background-color: transparent !important;
            color: black !important;
            border-bottom: 1px solid #374151 !important; /* keep only bottom border */
            border-right: none !important; /* remove vertical white lines */
        }

        /* Remove vertical grid lines inside body cells */
        #grid .k-grid-content td,
        #grid .k-table td {
            border-right: none !important;
        }

        /* Keep only horizontal separators */
        #grid .k-grid-content td,
        #grid .k-table td {
            border-bottom: 1px solid #e5e7eb !important;
        }


        .k-grid-dark .k-grid-content::-webkit-scrollbar {
            width: 8px;
        }

        .k-grid-dark .k-grid-content::-webkit-scrollbar-thumb {
            background: #555;
            border-radius: 4px;
        }

        .k-grid-dark .k-grid-content::-webkit-scrollbar-track {
            background: #1e1e1e;
        }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark text-text-light dark:text-text-dark">
    <div class="p-6 md:p-8">
        <main class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <div class="col-span-1 md:col-span-2 lg:col-span-4 bg-card-light dark:bg-card-dark p-6 rounded-lg shadow-md stats-cards">
                <h3 style="margin-bottom: 15px;">Recent Incidents</h3>

                @(Html.Kendo().Grid<Safety_Tech.Models.Models.Incidents>()
                    .Name("grid")
                    .Columns(columns =>
                    {
                        columns.Bound(p => p.CameraName)
                        .Title("Camera Name")
                        .Filterable(ftb => ftb.Cell(cell => cell.Operator("contains").SuggestionOperator(FilterType.Contains)));
                        columns.Bound(p => p.ViolationType)
                        .Title("Violation Type")
                        .Filterable(ftb => ftb.Cell(cell => cell.Operator("contains").SuggestionOperator(FilterType.Contains)));
                        columns.Bound(p => p.Timestamp)
                        .Title("Date")
                        .Format("{0:yyyy-MM-dd}")
                        .Filterable(ftb => ftb.Cell(cell => cell.ShowOperators(true)));

                        columns.Bound(p => p.CameraId).Title("Camera Id").Filterable(false);
                        columns.Bound(p => p.TrackId).Title("Track Id").Filterable(false);
                        columns.Bound(p => p.MissingLabels).Title("Missing Labels").Filterable(false);
                        columns.Bound(p => p.Id)
                        .Title("Actions")
                        .Encoded(false)
                        .Width(260)

                        .ClientTemplate(
                    @"<div style='display:flex;gap:6px;align-items:center;'>
                # if (!IsApprove && ApproveBy === '' ) { #
                <form method='post' action='/Incident/Approve'>
                <input type='hidden' name='incidentId' value='#= Id #' />
                <input type='hidden' name='__RequestVerificationToken' value='@Html.AntiForgeryToken().ToString()' />
                <button type='submit' class='k-button btn-approve'>Approve</button>
                </form>
                <form method='post' action='/Incident/Reject'>
                <input type='hidden' name='incidentId' value='#= Id #' />
                <input type='hidden' name='__RequestVerificationToken' value='@Html.AntiForgeryToken().ToString()' />
                <button type='submit' class='k-button btn-reject'>Reject</button>
                </form>
                # } else if(IsApprove) { #
                <span style='color:green;font-weight:400;'>Approve</span>
                # }
                else{ #
                <span style='color:red;font-weight:400;'>Reject</span>
                # }#
                <a href='javascript:void(0);'
                class='k-button btn-view'
                onclick=""showImage('#= Image #', '#= CameraName #')"">View</a>
                </div>"
                        )
                        .Filterable(false);
                    })
                    .Height("auto")
                    .Pageable(pageable => pageable.PageSizes(true))
                    .Sortable()
                    .Filterable()
                    .Scrollable()
                    .HtmlAttributes(new { style = "auto" })
                    .DataSource(dataSource => dataSource
                    .Ajax()
                    .PageSize(15)
                    .ServerOperation(false)
                    )
                    .BindTo(Model.Incidents)
                    )
             </div>
        </main>
    </div>
    



    <!-- Image Modal -->
    <div id="imageModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex items-center justify-center">
        <div class="bg-white dark:bg-gray-800 rounded-lg p-6 max-w-4xl max-h-[90vh] overflow-auto">
            <div class="flex justify-between items-center mb-4">
                <h3 id="modalTitle" class="text-lg font-semibold text-gray-900 dark:text-white"></h3>
                <button onclick="closeModal()" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
            <div class="text-center">
                <img id="modalImage" src="" alt="Incident Image"
                     class="max-w-full max-h-[70vh] mx-auto rounded-lg shadow-lg"
                     onerror="this.src='data:image/svg+xml;base64,'; this.alt='Image not found';">
            </div>
        </div>
    </div>

    <script>
        function showImage(imagePath, label) {
            document.getElementById('modalImage').src = imagePath;
            document.getElementById('modalTitle').textContent = 'Incident: ' + label;
            document.getElementById('imageModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('imageModal').classList.add('hidden');
        }

        // Close modal when clicking outside
        document.getElementById('imageModal').addEventListener('click', function (e) {
            if (e.target === this) {
                closeModal();
            }
        });

        // Close modal with Escape key
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                closeModal();
            }
        });
    </script>

</body>
</html>
