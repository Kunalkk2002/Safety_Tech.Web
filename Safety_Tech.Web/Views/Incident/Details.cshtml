@using Safety_Tech.Models.ViewModels
@model IncidentViewModel

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Health & Safety Dashboard</title>

    <!-- Tailwind & Fonts -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,typography"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />

    <!-- ✅ Kendo UI CSS -->
    <link rel="stylesheet" href="https://kendo.cdn.telerik.com/2023.2.829/styles/kendo.default-v2.min.css" />


    <!-- ✅ jQuery (must come first) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- ✅ Kendo UI JS -->
    <script src="https://kendo.cdn.telerik.com/2023.2.829/js/kendo.all.min.js"></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #131239 !important;
        }

        h3 {
            font-weight: 600;
            color: white !important;
            font-size: 1.2rem !important;
        }

        .stats-cards {
            background-color: #222A51 !important;
            color: white !important;
        }

        #grid {
            margin-top: 8px;
        }
    </style>
</head>

<body class="bg-background-light dark:bg-background-dark text-text-light dark:text-text-dark">
    <div class="p-6 md:p-8">
        <main class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <div class="col-span-1 md:col-span-2 lg:col-span-4 bg-card-light dark:bg-card-dark p-6 rounded-lg shadow-md stats-cards">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-4">
                    <h3 class="text-lg font-semibold">Recent Incidents</h3>
                </div>

                @(Html.Kendo().Grid<Safety_Tech.Models.Models.Incidents>()
                    .Name("grid")
                    .Columns(columns =>
                    {
                        columns.Bound(p => p.CameraName).Title("Camera Name");
                        columns.Bound(p => p.CameraId).Title("Camera Id");
                        columns.Bound(p => p.TrackId).Title("Track Id");
                        columns.Bound(p => p.MissingLabels).Title("Missing Labels");
                        columns.Bound(p => p.ViolationType).Title("Violation Type");
                        columns.Bound(p => p.Timestamp).Title("Date").Format("{0:yyyy-MM-dd HH:mm}");
                        columns.Command(command =>
                        {
                            command.Custom("Approve").Click("onApproveClick");
                            command.Custom("Reject").Click("onRejectClick");
                        }).Title("Actions").Width(200);
                    })
                    .Pageable()
                    .Sortable()
                    .Scrollable()
                    .Filterable(ftb => ftb.Mode(GridFilterMode.Row))
                    .HtmlAttributes(new { style = "height:500px;" })
                    .DataSource(ds => ds
                    .Ajax()
                    .PageSize(20)
                    .Read(read => read.Action("GetIncidents", "Incident"))
                    )
                    )

            </div>
        </main>
    </div>

    <script>
        function onApproveClick(e) {
            e.preventDefault();
            var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
            postAction('@Url.Action("Approve", "Incident")', dataItem.Id);
        }

        function onRejectClick(e) {
            e.preventDefault();
            var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
            postAction('@Url.Action("Reject", "Incident")', dataItem.Id);
        }

        function postAction(url, incidentId) {
            var form = $('<form/>', { action: url, method: 'post' })
                .append($('<input/>', { type: 'hidden', name: 'incidentId', value: incidentId }))
                .append('@Html.AntiForgeryToken()');
            form.appendTo('body').submit();
        }
    </script>

</body>
</html>
