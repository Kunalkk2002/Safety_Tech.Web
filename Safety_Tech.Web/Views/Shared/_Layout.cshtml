<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Safety_Tech.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Safety_Tech.Web.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

@if (!ViewContext.RouteData.Values["controller"].Equals("Auth") && !ViewContext.RouteData.Values["action"].Equals("loginView"))
{
    <header>
        <nav  class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-secondary bg-gradient text-light border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Index">DashBoard</a>
                        </li>   
                        <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Incident" asp-action="Details">Details</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
}

<div class="container">
    <main role="main" class="pb-3">
            @RenderBody()
    </main>
</div>

<footer class="bg-secondary text-light py-2 fixed-bottom text-center">
    <div class="container">
        <p class="mb-0">&copy; 2024 - Safety_Tech</p>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
