<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Safety_Tech.Web</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Safety_Tech.Web.styles.css" asp-append-version="true" />

    <!-- SweetAlert -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Kendo CSS -->
    <link href="https://kendo.cdn.telerik.com/2023.2.829/styles/kendo.default-v2.min.css" rel="stylesheet" />
</head>

<body>

@if (!ViewContext.RouteData.Values["controller"].Equals("Auth") && !ViewContext.RouteData.Values["action"].Equals("loginView"))
{
}

<div class="container">
    <main role="main" class="pb-3">
            @RenderBody()
    </main>
</div>

<footer class="bg-secondary text-light py-2 fixed-bottom text-center">
    <div class="container">
        <p class="mb-0">&copy; @DateTime.Now.Year - Safety Tech</p>
    </div>
</footer>

    <!-- jQuery (only ONE version) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Bootstrap JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Kendo JS -->
    <script src="https://kendo.cdn.telerik.com/2023.2.829/js/kendo.all.min.js"></script>

    <!-- Site JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Section scripts for individual views -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
