
@model List<Safety_Tech.DTOs.UserDTOs.GetUserDto>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User List - Safety_Tech.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="container mt-5">
        <h2 class="text-start">User List</h2>
        <div class="text-end">
            <a href="~/User/AddUser" class="btn btn-success">Add New User</a>
        </div>

        <div class="table-responsive mt-3">
            <table class="table table-bordered table-hover">
                <thead class="thead-dark">
                    <tr>
                        @* <th>Id</th> *@
                        <th>Name</th>
                        <th>Email</th>
                        <th>Active</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        @foreach (var user in Model)
                        {
                            <tr>
                                @* <td>@user.UserId</td> *@
                                <td>@user.UserName</td>
                                <td>@user.UserMail</td>
                                <td>@(user.IsActive ? "Yes" : "No")</td>
                                <td class="d-flex justify-content-center">
                                    <form asp-action="UpdateUser" method="post" style="display: inline; margin-right: 5px;">
                                        @Html.Hidden("userId", user.UserId)
                                        <button type="submit" id="updateUser" class="btn btn-warning btn-sm">Update</button>
                                    </form>
                                    <form asp-action="DeleteUser" method="post" style="display: inline;">
                                        @Html.Hidden("id", user.UserId)
                                        <button type="submit" id="updateUser" class="btn btn-danger btn-sm">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center">No users available.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
